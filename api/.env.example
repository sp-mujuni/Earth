# SQLite database path. Use a persistent mounted volume in production.
EARTH_WEATHER_DB=data/earth_weather.sqlite3

# Comma-separated allowed browser origins.
EARTH_CORS_ORIGINS=http://localhost:3000

# Required to enable POST /api/v1/ingest. Leave unset to keep ingestion disabled.
EARTH_INGEST_TOKEN=replace-with-a-long-random-secret
